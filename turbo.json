{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": "_state/quality-cache/turbo",
  "globalEnv": ["QUALITY_CACHE_RUNTIME", "NODE_OPTIONS"],
  "tasks": {
    "lint:knip:report": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.{js,mjs,cjs,ts,tsx,jsx,mts,cts}",
        "**/package.json",
        "**/tsconfig*.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!_state/**",
        "!_archive/**",
        "!.git/**",
        "!.agents/**",
        "!.venv/**"
      ],
      "outputs": []
    }
  },
  "globalDependencies": [
    "node_modules/.package-lock.json",
    "skills/turnstile-spin/templates/worker/node_modules/.package-lock.json"
  ]
}
