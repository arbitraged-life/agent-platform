{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent operation evidence v1",
  "description": "Strict lifecycle and operation evidence with optional bounded sanitized tool metadata; runtime validation enforces identifiers, timing, capture redaction and size.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_name",
    "trace_id",
    "runtime",
    "run_id",
    "observed_at",
    "recorded_at",
    "started_at",
    "ended_at",
    "tool_name",
    "tool_call_id",
    "action_key",
    "attempt_id",
    "outcome",
    "failure_stage",
    "handling_outcome",
    "reason_availability",
    "reason_provenance",
    "reason_code",
    "evidence_origin",
    "verification_status",
    "schema_version",
    "record_type",
    "production_eligible",
    "metrics"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "event_name": {
      "enum": [
        "agent.turn.started",
        "agent.operation.observed",
        "agent.turn.finished"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "runtime": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": ["string", "null"]
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "handling_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_availability": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_provenance": {
      "enum": [
        "raw_rejection",
        "raw_provider_error",
        "summary_only",
        "unavailable"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_origin": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "agent.evidence"
    },
    "production_eligible": {
      "type": "boolean"
    },
    "server_name": { "type": ["string", "null"], "pattern": "^[a-zA-Z0-9_.:-]{1,128}$" },
    "task_id": { "type": ["string", "null"], "pattern": "^[a-zA-Z0-9_.:-]{1,128}$" },
    "conversation_id": { "type": ["string", "null"], "pattern": "^[a-zA-Z0-9_.:-]{1,128}$" },
    "parent_event_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "tool_arguments": { "$ref": "#/$defs/capture" },
    "tool_result": { "$ref": "#/$defs/capture" },
    "metrics": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "telemetry-event.schema.json"
        }
      ]
    }
  },
  "$defs": {
    "capture": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["preview", "byte_count", "sha256", "truncated", "omitted", "redacted"],
          "properties": {
            "preview": {
              "type": ["string", "null"],
              "maxLength": 4096,
              "description": "Runtime validation additionally enforces a 4096-byte UTF-8 limit; JSON Schema maxLength counts characters, not bytes."
            },
            "byte_count": { "type": ["integer", "null"], "minimum": 0 },
            "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "truncated": { "type": "boolean" },
            "omitted": { "type": "boolean" },
            "redacted": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
