{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Public repository policy: Renovate selects dependency updates; GitHub native auto-merge executes eligible squash merges after enforced checks."
  ],
  "extends": [
    "config:best-practices",
    ":separateMultipleMajorReleases",
    "security:minimumReleaseAgePypi"
  ],
  "dependencyDashboard": true,
  "timezone": "America/Cancun",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Automatically merge stable minor and patch updates",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "addLabels": [
        "renovate-automerge"
      ],
      "automerge": true
    },
    {
      "description": "Automatically merge pins and digest refreshes",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "addLabels": [
        "renovate-automerge"
      ],
      "automerge": true
    },
    {
      "description": "Automatically merge lock-file maintenance",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "addLabels": [
        "renovate-automerge"
      ],
      "automerge": true
    },
    {
      "description": "Require explicit approval before creating major-update PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": [
        "renovate-major"
      ],
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates into one managed infrastructure PR",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group Terraform provider updates into one managed infrastructure PR",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_provider",
        "provider"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "terraform-providers"
    },
    {
      "description": "Group CircleCI image and orb updates into one managed infrastructure PR",
      "matchManagers": [
        "circleci"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "circleci"
    },
    {
      "description": "Keep pre-1.0 upgrades review-only unless separately approved",
      "matchCurrentVersion": "/^0/",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Hold npm releases for 14 days; require a verifiable registry timestamp before update admission",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "14 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Manually review npm pin, digest and lockfile updates that cannot prove release age",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": null
    },
    {
      "description": "Review CI actions, infrastructure, container images, and script-managed toolchain pins before merging",
      "matchManagers": [
        "github-actions",
        "circleci",
        "terraform",
        "dockerfile",
        "docker-compose",
        "custom.regex",
        "helmv3",
        "helm-values",
        "kubernetes",
        "devcontainer"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review dependency updates in CI, deployment and infrastructure manifests even when detected by another manager",
      "matchFileNames": [
        ".github/workflows/**",
        ".circleci/**",
        ".buildkite/**",
        "infra/**",
        "**/Dockerfile*",
        "**/compose.y*ml",
        "**/docker-compose.y*ml",
        "**/wrangler.toml",
        "**/wrangler.jsonc"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review runtime engine upgrades independently of dependency version classification",
      "matchDatasources": [
        "node-version",
        "python-version"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review authentication, cryptographic, cloud-control and MCP dependencies before merging",
      "matchPackageNames": [
        "@modelcontextprotocol/**",
        "@cloudflare/**",
        "@aws-sdk/**",
        "@auth/**",
        "@actions/**",
        "@octokit/auth-**",
        "@playwright/mcp",
        "@wonderwhy-er/desktop-commander",
        "mcp",
        "fastmcp",
        "mcp-remote",
        "mcp-proxy",
        "jose",
        "jsonwebtoken",
        "openid-client",
        "oauth4webapi",
        "passport",
        "passport-*",
        "next-auth",
        "cryptography",
        "authlib",
        "pyjwt",
        "python-jose",
        "requests-oauthlib",
        "google-auth",
        "google-auth-oauthlib",
        "pyopenssl",
        "msal",
        "certifi",
        "urllib3",
        "wrangler",
        "miniflare",
        "workerd",
        "@google-cloud/**",
        "google-cloud-*",
        "google-api-python-client",
        "@azure/**"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require explicit review for all lock-file maintenance because it refreshes transitive dependencies without release-age evidence",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": null
    },
    {
      "description": "Manually review update types without release-age timestamps instead of leaving them permanently pending",
      "matchUpdateTypes": [
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "minimumReleaseAge": null,
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Security patch runtime versions are reviewed and CI-gated; do not wait for ordinary weekly updates",
      "matchDatasources": [
        "node-version",
        "python-version"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "schedule": [],
      "automerge": false,
      "addLabels": [
        "security-toolchain"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned npm CLI versions embedded in scripts, YAML, and justfiles",
      "managerFilePatterns": [
        "/(^|/)justfile$/",
        "/\\.(sh|ya?ml)$/"
      ],
      "matchStrings": [
        "npx(?:\\s+--yes|\\s+-y)?\\s+(?<depName>@?[A-Za-z0-9._/-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track pinned Python packages passed to uv --with",
      "managerFilePatterns": [
        "/(^|/)justfile$/",
        "/\\.(sh|ya?ml)$/"
      ],
      "matchStrings": [
        "--with\\s+(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Track pinned Mergify CLI release versions",
      "managerFilePatterns": [
        "/\\.circleci\\/config\\.yml$/",
        "/\\.github\\/workflows\\/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "MERGIFY_VERSION=(?<currentValue>\\d{4}\\.\\d+\\.\\d+(?:\\.\\d+)?)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "Mergifyio/mergify-cli"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 10,
    "addLabels": [
      "security"
    ],
    "schedule": [],
    "prCreation": "immediate"
  },
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    "**/_archive/**",
    "**/_state/**"
  ],
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "ignoreTests": false
}
