{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Shared Renovate policy for arbitraged-life platform repositories",
    "Accept Renovate best-practices' 3-day npm release-age safeguard to reduce supply-chain risk.",
    "Group only low-coupling infrastructure update families; keep application/runtime dependency updates independently reviewable."
  ],
  "extends": [
    "config:best-practices",
    ":separateMultipleMajorReleases"
  ],
  "dependencyDashboard": true,
  "timezone": "America/Cancun",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Let Mergify auto-queue stable minor and patch updates",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "addLabels": [
        "renovate-automerge"
      ]
    },
    {
      "description": "Let Mergify auto-queue pins and digest refreshes",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "addLabels": [
        "renovate-automerge"
      ]
    },
    {
      "description": "Let Mergify auto-queue lock-file maintenance",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "addLabels": [
        "renovate-automerge"
      ]
    },
    {
      "description": "Require explicit approval before creating major-update PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": [
        "renovate-major"
      ]
    },
    {
      "description": "Group GitHub Actions updates into one managed infrastructure PR",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group Terraform provider updates into one managed infrastructure PR",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_provider",
        "provider"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "terraform-providers"
    },
    {
      "description": "Group CircleCI image and orb updates into one managed infrastructure PR",
      "matchManagers": [
        "circleci"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "circleci"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned npm CLI versions embedded in scripts, YAML, and justfiles",
      "managerFilePatterns": [
        "/(^|/)justfile$/",
        "/\\.(sh|ya?ml)$/"
      ],
      "matchStrings": [
        "npx(?:\\s+--yes|\\s+-y)?\\s+(?<depName>@?[A-Za-z0-9._/-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track pinned Python packages passed to uv --with",
      "managerFilePatterns": [
        "/(^|/)justfile$/",
        "/\\.(sh|ya?ml)$/"
      ],
      "matchStrings": [
        "--with\\s+(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "prConcurrentLimit": 10,
    "addLabels": [
      "security"
    ]
  },
  "labels": [
    "dependencies"
  ]
}
