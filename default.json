{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Shared Renovate policy for arbitraged-life platform repositories"],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "timezone": "America/Cancun",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "automergeType": "pr-comment",
  "automergeComment": "@Mergifyio queue",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Queue non-major updates through Mergify after Renovate sees green checks",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Require explicit approval before creating major-update PRs",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
