{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Shared Renovate policy for arbitraged-life platform repositories"
  ],
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "timezone": "America/Cancun",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Let Mergify auto-queue stable minor and patch updates",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "addLabels": [
        "renovate-automerge"
      ]
    },
    {
      "description": "Let Mergify auto-queue pins and digest refreshes",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "addLabels": [
        "renovate-automerge"
      ]
    },
    {
      "description": "Let Mergify auto-queue lock-file maintenance",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "addLabels": [
        "renovate-automerge"
      ]
    },
    {
      "description": "Require explicit approval before creating major-update PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": [
        "renovate-major"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "prConcurrentLimit": 10,
    "addLabels": [
      "security"
    ]
  },
  "labels": [
    "dependencies"
  ]
}
