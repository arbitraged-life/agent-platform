#!/usr/bin/env python3
"""Deterministic local and CI validation of public platform assets."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
VALIDATION_PYTHON = ROOT / '.venv/bin/python'
if __name__ == '__main__' and VALIDATION_PYTHON.exists() and Path(sys.prefix).resolve() != (ROOT / '.venv').resolve():
    os.execv(str(VALIDATION_PYTHON), [str(VALIDATION_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]])
try:
    import yaml
except ImportError:
    raise SystemExit('Validation dependencies missing; run ./scripts/setup') from None
if yaml.__version__ != '6.0.3':
    raise SystemExit('Validation dependency version mismatch; run ./scripts/setup')


def step_actions(steps):
    if not isinstance(steps, list):
        raise ValueError('Action steps must be a list')
    actions = []
    for step in steps:
        if not isinstance(step, dict):
            raise ValueError('Action step must be a mapping')
        if 'uses' in step:
            actions.append(step['uses'])
    return actions


def workflow_actions(text, composite=False):
    document = yaml.safe_load(text)
    if not isinstance(document, dict):
        raise ValueError('Action document must be a mapping')
    if composite:
        runs = document.get('runs')
        if not isinstance(runs, dict):
            raise ValueError('Action runs must be a mapping')
        return step_actions(runs.get('steps', [])) if runs.get('using') == 'composite' else []
    if not isinstance(document.get('jobs'), dict):
        raise ValueError('Workflow jobs must be a mapping')
    actions = []
    for job in document['jobs'].values():
        if not isinstance(job, dict):
            raise ValueError('Workflow job must be a mapping')
        if 'uses' in job:
            actions.append(job['uses'])
        actions.extend(step_actions(job.get('steps', [])))
    return actions


def source_files():
    names = subprocess.check_output(['git', '-C', str(ROOT), 'ls-files', '-z'], text=True)
    return [ROOT / name for name in names.split('\0') if name]


def package_failures(document, relative):
    failures = []
    if any(document.get(group) for group in ['dependencies', 'optionalDependencies', 'peerDependencies']):
        failures.append(f'{relative}: production dependencies violate the standard-library runtime contract')
    for name, version in document.get('devDependencies', {}).items():
        if not isinstance(version, str) or not re.fullmatch(r'\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?', version):
            failures.append(f'{relative}: dependency {name} is not a pinned registry version')
    return failures


def boundaries(files, root=None):
    root = root or ROOT
    failures = []
    for path in files:
        relative = path.relative_to(root)
        if path.is_symlink():
            failures.append(f'{relative}: release sources cannot be symlinks')
            continue
        if (path.name == '.env' or path.name.startswith('.env.')) or path.suffix in ['.pem', '.key']:
            failures.append(f'{relative}: credential-shaped file')
        data = path.read_bytes()
        if b'\0' in data:
            failures.append(f'{relative}: binary asset needs an explicit publication review')
            continue
        text = data.decode('utf-8')
        if re.search(r'(?:/(?:Users|home)/[^/\s]+(?:/|(?=\s|$))|[A-Za-z]:[\\/]Users[\\/][^\\/\s]+)', text):
            failures.append(f'{relative}: absolute user-directory reference')
        if re.search(r'-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----', text):
            failures.append(f'{relative}: private key')
        if path.suffix in ['.mjs', '.js', '.ts']:
            for match in re.finditer(r'(?:from\s*|import\s*\(\s*|import\s+)[\x22\x27]([^\x22\x27]+)[\x22\x27]', text):
                if match[1].startswith(('file:', '/', '\\')) or re.match(r'^[A-Za-z]:', match[1]) or (match[1].startswith('.') and not (path.parent / match[1]).resolve().is_relative_to(root.resolve())):
                    failures.append(f'{relative}: import escapes public package boundary')
        composite = path.name in ('action.yml', 'action.yaml') and relative.parts[:2] != ('.github', 'workflows')
        if path.suffix in ['.yml', '.yaml'] and (composite or relative.parts[:2] == ('.github', 'workflows')):
            try:
                for action in workflow_actions(text, composite=composite):
                    if not isinstance(action, str) or (not action.startswith('./') and not re.fullmatch(r'[^\s]+@[0-9a-f]{40}', action)):
                        failures.append(f'{relative}: external action is not commit-pinned')
            except (yaml.YAMLError, ValueError):
                failures.append(f'{relative}: invalid workflow structure')
        if path.suffix == '.json':
            document = json.loads(text)
            if path.name == 'package.json':
                failures.extend(package_failures(document, relative))
        if path.suffix == '.py' or relative == Path('scripts/validate'):
            compile(text, str(relative), 'exec')
    return failures


def lint_sources(files, root):
    errors = boundaries(files, root)
    if errors:
        raise SystemExit('\n'.join(errors))
    for path in files:
        if path.suffix in ['.mjs', '.js', '.cjs']:
            try:
                subprocess.run(['node', '--check', str(path)], check=True, cwd=root)
            except subprocess.CalledProcessError:
                raise SystemExit(f'{path.relative_to(root)}: JavaScript syntax check failed') from None
    print('Source syntax, JSON, release boundaries, and action pins passed.', flush=True)


def lint_index():
    # Materialize the index, including staged deletions, without changing the worktree.
    names = subprocess.check_output(['git', '-C', str(ROOT), 'ls-files', '-z'], text=True)
    with tempfile.TemporaryDirectory(prefix='platform-index-') as directory:
        root = Path(directory)
        subprocess.run(['git', '-C', str(ROOT), 'checkout-index', '--all',
                        '--prefix=' + str(root) + '/'], check=True)
        lint_sources([root / name for name in names.split('\0') if name], root)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', nargs='?', choices=['ci', 'lint', 'test', 'eval', 'security'], default='ci')
    parser.add_argument('--staged', action='store_true', help='Lint the Git index instead of working files')
    args = parser.parse_args()
    if args.staged:
        if args.command != 'lint':
            parser.error('--staged is supported only for lint')
        lint_index()
        return
    files = source_files()
    if args.command in ['ci', 'lint', 'security']:
        lint_sources(files, ROOT)
    if args.command in ['ci', 'test']:
        tests = sorted(str(p.relative_to(ROOT)) for p in ROOT.glob('tests/unit/*.test.mjs'))
        subprocess.run(['node', '--test', *tests], check=True, cwd=ROOT)
        subprocess.run([sys.executable, '-m', 'unittest', 'discover', '-s', '.github/scripts', '-p', 'test_*.py'], check=True, cwd=ROOT)
        subprocess.run([sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_*.py'], check=True, cwd=ROOT)
    if args.command in ['ci', 'eval']:
        subprocess.run(['node', 'evals/routing.mjs'], check=True, cwd=ROOT)


if __name__ == '__main__':
    main()
